html {
  scroll-behavior: smooth;
  scroll-padding-top: 90px;
}
* {
  box-sizing: border-box;
}
body {
  margin: 0;
  font-family: Inter, sans-serif;
  color: #333;
  background: #f7f5f0;
  line-height: 1.7;
}
.container {
  width: min(1120px, 92%);
  margin: auto;
}
header {
  position: sticky;
  top: 0;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(8px);
  border-bottom: 1px solid #ddd;
  z-index: 10;
}
.nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 80px;
}
.logo {
  text-decoration: none;
  color: #333;
}
.logo span {
  display: block;
  font-size: 0.75rem;
  letter-spacing: 0.2em;
}
.logo strong {
  font: 700 1.6rem "Libre Baskerville", serif;
}
nav a {
  text-decoration: none;
  color: #333;
  margin-left: 24px;
  position: relative;
}
nav a:after {
  content: "";
  position: absolute;
  left: 0;
  bottom: -6px;
  width: 100%;
  height: 2px;
  background: #456b3f;
  transform: scaleX(0);
  transition: 0.25s;
}
nav a:hover:after {
  transform: scaleX(1);
}
.hero {
  background: linear-gradient(rgba(0, 0, 0, 0.45), rgba(0, 0, 0, 0.45)),
    url("../images/hero.jpg") center/cover;
  min-height: 90vh;
}
.hero-overlay {
  min-height: 90vh;
  display: flex;
  align-items: center;
}
.hero-content {
  text-align: center;
  color: #fff;
}
.hero h1 {
  font: 700 clamp(3.5rem, 8vw, 6rem) "Libre Baskerville", serif;
  margin: 0;
}
.hero p {
  max-width: 700px;
  margin: 25px auto;
}
.buttons {
  display: flex;
  gap: 15px;
  justify-content: center;
  flex-wrap: wrap;
}
.button {
  background: #456b3f;
  color: #fff;
  padding: 14px 28px;
  border-radius: 40px;
  text-decoration: none;
  font-weight: 700;
  display: inline-block;
}
.button:hover {
  background: #355834;
}
.outline {
  background: transparent;
  border: 2px solid rgba(255, 255, 255, 0.8);
}
.light {
  background: #fff;
  color: #355834;
}
section {
  padding: 100px 0;
}
h2 {
  font: 700 clamp(2rem, 4vw, 3rem) "Libre Baskerville", serif;
}
.two-column {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 60px;
  align-items: center;
}
.two-column img,
.gallery-grid img {
  width: 100%;
  border-radius: 16px;
}
.services {
  background: #efebe2;
}
.cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 24px;
}
.card {
  background: #fff;
  padding: 30px;
  border-radius: 16px;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
}

.gallery-grid {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr;
  gap: 20px;
}
.gallery-grid img:first-child {
  grid-row: span 2;
  height: 100%;
}
.gallery-grid img {
  height: 250px;
  object-fit: cover;
}

.about {
  background: #efebe2;
}
.contact {
  text-align: center;
  background: #405b43;
  color: #fff;
}
.contact h2,
.contact p {
  color: #fff;
}
footer {
  background: #222;
  color: #bbb;
  text-align: center;
  padding: 25px;
}
@media (max-width: 800px) {
  .nav,
  .two-column {
    flex-direction: column;
    display: block;
  }
  .gallery-grid {
    grid-template-columns: 1fr;
  }
  .gallery-grid img,
  .gallery-grid img:first-child {
    height: 280px;
  }
}
